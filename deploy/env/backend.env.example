# 复制到服务器 /var/www/admin/backend/.env 并修改

DEBUG=False
SECRET_KEY=请替换为随机长字符串
ALLOWED_HOSTS=admin.wangyixiang.xyz,seller.wangyixiang.xyz,customer.wangyixiang.xyz,wangyixiang.xyz,127.0.0.1

# 浏览器经 Cloudflare 隧道访问为 HTTPS，此处填公网 https 域名（非源站 http）
CORS_ALLOWED_ORIGINS=https://admin.wangyixiang.xyz,https://seller.wangyixiang.xyz,https://customer.wangyixiang.xyz
CSRF_TRUSTED_ORIGINS=https://admin.wangyixiang.xyz,https://seller.wangyixiang.xyz,https://customer.wangyixiang.xyz
ACTIVATION_LINK_BASE=https://admin.wangyixiang.xyz

# 电商 Daphne 端口（8000/8001 已被占用时改此处，部署脚本会同步到 Nginx）
# Nginx 在 Docker 容器、Daphne 在宿主机时：必须 0.0.0.0，否则容器经 172.17.0.1 访问会 502
BACKEND_BIND=0.0.0.0
BACKEND_PORT=8002
# Nginx 反代 upstream 主机（Daphne 在宿主机、Nginx 在 Docker 容器内）
# Linux 请用 Docker 网桥网关（常见 172.17.0.1），勿用 host.docker.internal（仅 Docker Desktop）
# 部署后执行: bash deploy/scripts/sync-backend-port.sh
BACKEND_UPSTREAM_HOST=172.17.0.1

# sqlite 或 mysql
DB_ENGINE=sqlite
# DB_ENGINE=mysql
# DB_NAME=admin_db
# DB_USER=admin
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# WebSocket 实时通知（Daphne + Channels）
# 单进程 Daphne 可不配 Redis；多 worker / 水平扩展时必须开启：
# REDIS_URL=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------------------
# 商城手机号短信验证码（注册 / 短信登录 / 找回密码）
# 详见 adminAPI/.env.example 与 customers/sms_service.py
# ---------------------------------------------------------------------------
# False=开发模式：验证码写日志，API 响应可能带 dev_code（勿用于生产）
# True=阿里云号码认证服务真实发短信，需填写 AccessKey 与签名模板
# ALIYUN_SMS_ENABLED=False
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=速通互联验证码
# ALIYUN_SMS_TEMPLATE_CODE=100001
# ALIYUN_SMS_RESET_SIGN_NAME=云渚科技验证平台
# ALIYUN_SMS_RESET_TEMPLATE_CODE=100003
# SMS_RESEND_SECONDS=60

# 邮件等其它配置参见 adminAPI/.env.example
