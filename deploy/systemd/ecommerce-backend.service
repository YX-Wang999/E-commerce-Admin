[Unit]
Description=E-commerce Django ASGI (Daphne)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/www/admin/backend
Environment=PYTHONUNBUFFERED=1
Environment=BACKEND_PORT=8002
Environment=BACKEND_BIND=127.0.0.1
EnvironmentFile=-/var/www/admin/backend/.env
ExecStart=/var/www/admin/backend/venv/bin/daphne -b ${BACKEND_BIND} -p ${BACKEND_PORT} config.asgi:application
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
